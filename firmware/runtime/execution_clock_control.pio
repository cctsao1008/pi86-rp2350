.program rp86_free_running_clock_control
.wrap_target
continue:
    ; Ten PIO cycles form one complete Intel 8086 processor clock:
    ;   HIGH = 4 SM cycles
    ;   LOW  = 6 SM cycles, including the safe-stop poll below
    ;
    ; The divider therefore runs this SM at 10x the requested processor clock.
    ; At 8 MHz this produces HIGH=50 ns, LOW=75 ns; at the Issue #106
    ; engineering baseline of 6 MHz it produces HIGH~=66.7 ns, LOW=100 ns.
    ; The 2:3 ratio matches the dedicated rp86_intel_8086_clock lab waveform
    ; while preserving the bounded low-phase stop handshake.
    set pins, 1 [3]
    set pins, 0 [2]

    ; With an empty TX FIFO, PULL NOBLOCK copies X (normally zero) into OSR.
    ; A Host stop token supplies bit zero as one. The SM examines that token
    ; only after the low half-cycle is complete.
    pull noblock
    out x, 1
    jmp !x continue

    ; Return an acknowledgement through this SM's RX FIFO, then block on an
    ; empty TX FIFO. CLK is already low and cannot restart before firmware
    ; disables/reinitializes the state machine.
    set y, 1
    mov isr, y
    push block
    pull block
.wrap
