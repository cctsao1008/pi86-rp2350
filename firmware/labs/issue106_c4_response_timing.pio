.pio_version rp2350

.program issue106_c4_frontend
; One-shot physical T1 -> backing SRAM pointer frontend.
; backing is 64 KiB aligned and byte-addressed:
;   pointer = backing[31:16] : A15..A0
; Only the first WORD lane is published; then the SM parks.

    wait 0 gpio 16             ; RESET deasserted
    wait 1 gpio 21             ; establish a clean post-reset clock phase
    wait 0 gpio 21
    wait 0 gpio 9              ; reject RESET-release/transient ASTB high
    wait 1 gpio 9              ; first clock-qualified bus-cycle ASTB rise
    nop [7]
    mov isr, pins
    mov y, isr

    mov isr, null
    pull block              ; backing base high 16
    mov x, osr
    in x, 16

bit_loop:
    pull block
    mov x, osr
    mov osr, y
    mov exec, x
    out x, 1
    in x, 1
    jmp bit_loop

finish_pointer:
    ; WORD qualification from the same saved T1 snapshot.
    mov osr, y
    out null, 25           ; BHE#
    out x, 1
    jmp !x bhe_asserted
    jmp park

bhe_asserted:
    mov osr, y
    out null, 26           ; A0
    out x, 1
    jmp !x word_lane
    jmp park

word_lane:
    push block

park:
    jmp park


.program issue106_c4_byte_lut_pointers
; Convert one raw SRAM word into two absolute 1 KiB LUT pointers.
;
; TX order:
;   [0] low_lut base >> 10 (22 significant bits), preloaded by M33
;   [1] raw SRAM word, delivered by dynamic SRAM-read DMA
;   [2] high_lut base >> 10, delivered by a chained one-word DMA
;
; RX order:
;   [0] &low_lut[D7:D0]
;   [1] &high_lut[D15:D8]
;
; Both LUTs are 1024-byte aligned and contain 256 x uint32_t entries.
    pull block
    mov x, osr                 ; low LUT base >> 10
    pull block
    mov y, osr                 ; preserve raw SRAM word

    mov isr, null
    in x, 22
    mov osr, y
    out x, 8                   ; low byte
    in x, 8
    in null, 2                 ; uint32_t index scaling
    push block

    pull block
    mov x, osr                 ; high LUT base >> 10
    mov isr, null
    in x, 22
    mov osr, y
    out null, 8
    out x, 8                   ; high byte
    in x, 8
    in null, 2
    push block

builder_park:
    jmp builder_park


.program issue106_c4_responder
; Initial TX word is the full scattered AD direction mask.
; Next TX word is a pre-encoded GPIO0..27 data bitmap from response_lut.
; The response is one-shot. AD is released after two post-drive falling CLK
; edges; the observer independently determines which CPU phase first saw the
; correct word.
    pull block
    wait 0 gpio 9
    out pins, 28
    mov pindirs, ~null

    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21

    mov pindirs, null
responder_park:
    jmp responder_park


.program issue106_c4_observer
; One-shot independent physical phase observer.
; RESET deassertion is a hardware gate, so no RESET-time ASTB transition can
; consume the instrument at high processor clocks.
;
; RX sequence:
;   [0] T1 sample (+8 PIO cycles after ASTB rise)
;   [1] AF: ASTB falling edge
;   [2] R1
;   [3] F1
;   [4] R2
;
; With the responder (12 instructions), this observer (19) occupies 31 of the
; 32 instructions in PIO2. The free-running clock therefore lives on PIO1.

    wait 0 gpio 16             ; RESET deasserted
    wait 1 gpio 21             ; establish a clean post-reset clock phase
    wait 0 gpio 21
    wait 0 gpio 9              ; reject RESET-release/transient ASTB high
    wait 1 gpio 9              ; first clock-qualified bus-cycle ASTB rise
    nop [7]
    mov isr, pins
    push block

    wait 0 gpio 9
    mov isr, pins
    push block

    wait 1 gpio 21
    mov isr, pins
    push block

    wait 0 gpio 21
    mov isr, pins
    push block

    wait 1 gpio 21
    mov isr, pins
    push block

observer_park:
    jmp observer_park
