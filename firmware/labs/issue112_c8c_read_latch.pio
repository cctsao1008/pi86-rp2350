.pio_version rp2350

.program issue112_c8c_addr_frontend
; Continuous C5C-style read address frontend.
    pull block
    mov y, osr

    wait 0 gpio 16
    wait 1 gpio 21
    wait 0 gpio 21
.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]

    mov isr, null
    in y, 16
    in pins, 14
    in null, 2
    push block
    jmp next_cycle
.wrap


.program issue112_c8c_responder
; Read response + write-data capture.
; BUFRW is jmp pin: LOW=read, HIGH=write.
.wrap_target
response_loop:
    pull block
    wait 0 gpio 9
    jmp pin write_cycle

read_cycle:
    out pins, 28
    mov pindirs, ~null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    mov pindirs, null
    jmp response_loop

write_cycle:
    mov pindirs, null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21             ; R2
    mov isr, pins
    push block                 ; write data only
    jmp response_loop
.wrap


.program issue112_c8c_pointer_router
; TX receives the current backing pointer only AFTER the SRAM read DMA has
; completed for that bus cycle. BUFRW is jmp pin.
;
; Reads discard the pointer. Writes publish it to RX, providing a write-only
; pointer FIFO independent from the responder's write-data FIFO.
.wrap_target
router_loop:
    pull block
    mov y, osr
    wait 0 gpio 9
    jmp pin publish_write
    jmp router_loop

publish_write:
    mov isr, y
    push block
    jmp router_loop
.wrap


.program issue112_c8c_observer
; Per-cycle evidence: T1 + AF/R1/F1/R2.
; This measures how early the read value becomes physically valid.
.wrap_target
observer_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block

    wait 0 gpio 9              ; AF
    mov isr, pins
    push block

    wait 1 gpio 21             ; R1
    mov isr, pins
    push block

    wait 0 gpio 21             ; F1
    mov isr, pins
    push block

    wait 1 gpio 21             ; R2
    mov isr, pins
    push block

    jmp observer_next
.wrap


.program issue112_pi_out_observer
; Passive continuous-PI witness observer.
; Samples the multiplexed AD address during T1 and publishes only BUFRW=HIGH
; write cycles. The stackless PI workload performs exactly one OUT DX,AL per
; completed calculation, so the pushed raw GPIO snapshot carries the computed
; Q3.13 PI result in the I/O port address. PUSH is non-blocking: observation
; can never stall the physical processor.
.wrap_target
observe_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    jmp pin publish_write
    wait 0 gpio 9
    jmp observe_next

publish_write:
    push noblock
    wait 0 gpio 9
    jmp observe_next
.wrap
