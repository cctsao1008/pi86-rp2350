.pio_version rp2350

.program issue106_intel_clock_trace
.side_set 1
; Intel 8086-2 synchronous reset + clock + raw bus trace.
;
; PIO owns:
;   side-set pin -> CLK   (GPIO21)
;   SET pin      -> RESET (GPIO16)
;
; Processor period = 5 SM cycles:
;   HIGH: 2 cycles
;   LOW : 3 cycles
;
; Eight complete reset clocks are deliberately unrolled. A JMP-based counter
; would add an extra low-phase instruction cycle and distort the Intel clock.
; RESET is deasserted at a deterministic low-clock boundary before tracing.
;
; Trace pushes are noblock so instrumentation can never stall the clock.

    set pins, 1                side 0  ; RESET asserted

    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]

    set pins, 0                side 0  ; deterministic RESET deassert

.wrap_target
    mov isr, pins              side 1
    push noblock               side 1
    mov isr, pins              side 0
    push noblock               side 0
    nop                        side 0
.wrap
