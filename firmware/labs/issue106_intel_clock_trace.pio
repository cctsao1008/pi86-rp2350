.pio_version rp2350

.program issue106_intel_clock_trace
.side_set 1
; Intel 8086-2 synchronous reset + clock + raw bus trace.
;
; PIO owns both:
;   side-set pin -> CLK (GPIO21)
;   SET pin      -> RESET (GPIO16)
;
; One processor period = 5 SM cycles:
;   HIGH: 2 cycles
;   LOW : 3 cycles
;
; RESET is held asserted for eight complete processor clocks entirely in PIO.
; It is then deasserted at a deterministic LOW-clock boundary before any trace
; samples are pushed. No M33 polling or gpio_put participates in this boundary.
;
; TX preload:
;   one word whose low 5 bits are reset-period count minus one (=7).

    pull block                 side 0
    mov x, osr                 side 0
    set pins, 1                side 0  ; RESET asserted

reset_clock_loop:
    nop                        side 1 [1] ; HIGH 2 cycles
    nop                        side 0 [2] ; LOW  3 cycles
    jmp x-- reset_clock_loop   side 0

    set pins, 0                side 0  ; deterministic RESET deassert

.wrap_target
    mov isr, pins              side 1
    push noblock               side 1
    mov isr, pins              side 0
    push noblock               side 0
    nop                        side 0
.wrap
