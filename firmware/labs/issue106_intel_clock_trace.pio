.pio_version rp2350

.program issue106_intel_clock_reset
.side_set 1
; Intel 8086-2 clock + deterministic RESET release.
; PIO owns CLK (side-set GPIO21) and RESET (SET GPIO16).
; Eight complete 2-high/3-low clocks are unrolled while RESET is asserted.
; IRQ0 is raised immediately after RESET deassertion so a companion observer
; can arm on the exact hardware boundary.

    set pins, 1                side 0

    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]
    nop                        side 1 [1]
    nop                        side 0 [2]

    set pins, 0                side 0
    irq 0                      side 0

.wrap_target
    nop                        side 1 [1]
    nop                        side 0 [2]
.wrap


.program issue106_post_reset_t1_observer
; Hardware-gated companion observer.
; Wait for the clock/reset SM IRQ, then capture settled T1 snapshots directly
; from ASTB. The ~26.7 ns delay is four PIO cycles at 150 MHz and is outside
; the processor-clock generator, so it cannot distort CLK duty cycle.

    wait 1 irq 0
    irq clear 0
    wait 0 gpio 9

.wrap_target
    wait 1 gpio 9
    nop [3]
    mov isr, pins
    push block
    wait 0 gpio 9
.wrap
