.pio_version rp2350

.program issue112_c9d_addr_frontend
; Continuous C5C-style read address frontend.
    pull block
    mov y, osr

    wait 0 gpio 16
    wait 1 gpio 21
    wait 0 gpio 21
.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
public address_settle:
    nop [7]

    mov isr, null
    in y, 16
    in pins, 14
    in null, 2
    push block
    jmp next_cycle
.wrap


.program issue112_c9d_responder
; Read response + write-data capture.
; BUFRW is jmp pin: LOW=read, HIGH=write.
.wrap_target
response_loop:
    pull block
    wait 0 gpio 9
    jmp pin write_cycle

read_cycle:
    out pins, 28
    mov pindirs, ~null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
public read_f2:
    wait 0 gpio 21
    mov pindirs, null
    jmp response_loop

write_cycle:
    mov pindirs, null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21             ; R2
    mov isr, pins
    push block                 ; write data only
    jmp response_loop
.wrap


.program issue112_c9d_pointer_router
; TX receives the current backing pointer only AFTER the SRAM read DMA has
; completed for that bus cycle. BUFRW is jmp pin.
;
; Reads discard the pointer. Writes publish it to RX, providing a write-only
; pointer FIFO independent from the responder's write-data FIFO.
.wrap_target
router_loop:
    pull block
    mov y, osr
    wait 0 gpio 9
    jmp pin publish_write
    jmp router_loop

publish_write:
    mov isr, y
    push block
    jmp router_loop
.wrap


.program issue112_c9d_observer
; Diagnostic write-only observer.
; jmp pin = BUFRW: LOW=read, HIGH=write.
; RX publishes two words per physical write:
;   [0] T1 GPIO snapshot (address/control)
;   [1] R2 GPIO snapshot (write data)
.wrap_target
observer_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov x, pins
    jmp pin capture_write
    jmp observer_next

capture_write:
    mov isr, x
    push block

    wait 0 gpio 9              ; AF
    wait 1 gpio 21             ; R1
    wait 0 gpio 21             ; F1
    wait 1 gpio 21             ; R2
    mov isr, pins
    push block
    jmp observer_next
.wrap


.program issue112_c9j_window_observer
; T1 + AF/R1/F1/F1_LATE/R2/R2_LATE/F2 GPIO samples.
.wrap_target
observer_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block

    wait 0 gpio 9              ; AF
    mov isr, pins
    push block

    wait 1 gpio 21             ; R1
    mov isr, pins
    push block

    wait 0 gpio 21             ; F1
    mov isr, pins
    push block

    nop [11]
    mov isr, pins               ; F1_LATE
    push block

    wait 1 gpio 21             ; R2
    mov isr, pins
    push block

    nop [5]
    mov isr, pins               ; R2_LATE
    push block

    wait 0 gpio 21              ; F2
    mov isr, pins
    push block

    jmp observer_next
.wrap

; Each byte lane uses a separate PIO block. Its phase SM raises local IRQ 0
; at the rising edge in T3. Reads hold through the following falling edge.
.program issue112_c9o_phase
.wrap_target
    wait 1 gpio 9
    irq clear 0
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    irq 0
.wrap

.program issue112_c9o_responder
; TX = lane backing value, then its address. Active writes publish an
; address/data pair on RX. Reads drive only this PIO block's eight AD pins.
.wrap_target
next_cycle:
    wait 1 gpio 9
    nop [7]
    mov osr, pins
public select_bit:
    out null, 26                ; low: A0, patched to UBE# for high
    out x, 1                    ; 0 means selected
    pull block
    wait 0 gpio 9
    jmp pin write_cycle
    out pins, 28
    jmp x-- skip_drive
    wait 0 gpio 21
    mov pindirs, ~null
skip_drive:
    pull block                  ; discard backing address
    wait 1 irq 0
    wait 0 gpio 21 [4]          ; start T4, then hold
    mov pindirs, null
    jmp next_cycle
write_cycle:
    pull block                  ; backing address
    jmp x-- next_cycle
    mov isr, osr
    push block
    wait 1 irq 0
    mov isr, pins
    push block
.wrap

.program issue112_c9o_observer
; Compact observer shares instruction memory with address lookup and CLK.
.wrap_target
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    mov isr, pins               ; T3 rising
    push block
    wait 0 gpio 21
    mov isr, pins               ; T4 entry
    push block
.wrap

.program issue112_c9q_responder
; TX = lane backing value, then its address. Active writes publish an
; address/data pair on RX. Reads drive only this PIO block's eight AD pins.
.wrap_target
next_cycle:
    wait 1 gpio 9 [8]
    mov osr, pins
public select_bit:
    out null, 26                ; low: A0, patched to UBE# for high
    out x, 1                    ; 0 means selected
    pull block
    wait 0 gpio 9
    jmp pin write_cycle
    out pins, 28
    jmp x-- skip_drive
    wait 0 gpio 21
    mov pindirs, ~null
skip_drive:
    pull block                  ; discard backing address
    wait 1 irq 0
    wait 0 gpio 21 [4]          ; start T4, then hold
    mov pindirs, null
    jmp next_cycle
write_cycle:
    pull block                  ; backing address
    jmp x-- next_cycle
    in osr, 32 [1]              ; autopush pointer, retain two instruction cycles
    wait 1 irq 0
    in pins, 32 [1]             ; autopush data sampled on the original cycle
.wrap


.program issue112_c9q_address_observer
; Independent of the clock-phase tracker and of the responder's DMA FIFO.
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9 [8]
    in pins, 32
.wrap

.program issue112_c9q_window_observer
; Compact observer shares instruction memory with address lookup and CLK.
.wrap_target
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    mov isr, pins               ; T3 entry
    push block
    wait 1 gpio 21
    mov isr, pins               ; T3 rising
    push block
    wait 0 gpio 21
    mov isr, pins               ; T4 entry
    push block
.wrap


; C9S: deterministic read-drive phase.
;
; The phase SM latches two one-shot events per bus cycle:
;   IRQ1 = fixed drive-enable phase (first CLK falling edge after ALE/T1)
;   IRQ0 = fixed write-sample/read-release reference (T3 rising)
;
; The responder no longer chooses a drive edge with a level-sensitive
; 'wait 0 gpio CLK' after a potentially variable-duration DMA pull.  IRQ1
; remains asserted until consumed, so a slightly late pull cannot slip to the
; next falling edge.  READY remains fixed asserted; a genuinely missed
; deadline will still surface as a CPU-echo failure rather than being hidden.
.program issue112_c9s_phase
.wrap_target
    wait 1 gpio 9
    wait 1 gpio 21
    wait 0 gpio 21
    irq 1
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    irq 0
.wrap

.program issue112_c9s_responder
; TX order per lane remains: encoded backing data, then backing pointer.
; C9S is intentionally an aligned-WORD timing repair probe; both byte-lane
; responders are active for every C9R access.
.wrap_target
next_cycle:
    wait 1 gpio 9
    pull block                  ; encoded lane data; may complete variably
    wait 0 gpio 9
    jmp pin write_cycle

read_cycle:
    out pins, 28                ; preload output latch without driving
    wait 1 irq 1                ; fixed drive-enable event
    irq clear 1
    mov pindirs, ~null
    pull block                  ; discard backing pointer
    wait 1 irq 0
    irq clear 0
    wait 0 gpio 21 [4]          ; retain C9O/Q T4 hold policy
    mov pindirs, null
    jmp next_cycle

write_cycle:
    pull block                  ; backing pointer
    mov isr, osr
    push block
    wait 1 irq 1                ; consume the per-cycle drive event
    irq clear 1
    wait 1 irq 0                ; sample write data at fixed reference
    irq clear 0
    mov isr, pins
    push block
    jmp next_cycle
.wrap


; C9X: early-preload single 16-bit responder.
;
; The SRAM word is copied into the PIO output latch while AD pins remain
; inputs during T1.  BUFRW is already stable for the bus cycle, so reads wait
; only for ASTB to fall and then enable PINDIRS immediately.  This removes
; OUT PINS and direction-branch latency from the T2 read setup window without
; driving against the CPU address phase.
.program issue112_c9x_early_responder
.wrap_target
response_loop:
    pull block
    out pins, 28                ; preload GPIO output latch, still Hi-Z
    jmp pin write_cycle         ; BUFRW: LOW=read, HIGH=write

read_cycle:
    wait 0 gpio 9               ; end of T1 / ASTB low
    mov pindirs, ~null          ; begin driving on the next PIO cycle
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21 [4]          ; retain the proven late-release margin
    mov pindirs, null
    jmp response_loop

write_cycle:
    wait 0 gpio 9
    mov pindirs, null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21              ; R2 write-data sample
    mov isr, pins
    push block
    jmp response_loop
.wrap


; C9Z: guaranteed bus-turnaround phase for single 16-bit reads.
;
; Upstream Pi86 samples ALE/address, advances one complete processor CLK, then
; changes the multiplexed AD bus to output.  C9Z mirrors that policy in PIO:
; after ASTB is observed high, normalise to a CLK-low boundary, consume one
; complete rising+falling CLK, then latch IRQ1.  The responder preloads the
; output latch while Hi-Z and only enables PINDIRS after this event.
.program issue112_c9z_turnaround_phase
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    irq 1
.wrap

.program issue112_c9z_turnaround_responder
.wrap_target
next_cycle:
    pull block
    out pins, 28                ; preload while AD remains Hi-Z
    wait 0 gpio 9
    jmp pin write_cycle         ; BUFRW: LOW=read, HIGH=write

read_cycle:
    wait 1 irq 1
    irq clear 1
    mov pindirs, ~null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21 [4]
    mov pindirs, null
    jmp next_cycle

write_cycle:
    ; PINDIRS is already Hi-Z at every cycle boundary.
    wait 1 irq 1                ; consume this cycle's turnaround event
    irq clear 1
    wait 1 gpio 21
    mov isr, pins
    push block
    jmp next_cycle
.wrap


; C10: one-SM compact 16-bit address frontend for the 64 KiB mirror lab.
;
; AD0..AD15 are scattered over GPIO0..27.  A0/AD0 is not required for
; backing-word lookup because even and odd byte cycles share the same aligned
; 16-bit backing word. Compact A15..A1 in ascending GPIO-number order:
;   0, 2,3,4, 6, 10,11,12,13,14,15, 17, 19, 22, 27
;
; Y holds bits 31:17 of a 128 KiB-aligned 32K-entry LUT base.  The final
; autopushed word is:
;   [ LUT base high 15 ][ compact A15..A1 index 15 ][ 00 ]
; which is the byte address of compact_addr_lut[index].
;
; OUT shifts OSR right; IN shifts ISR left.  The program consumes all GPIO0..27
; bits exactly once, discarding non-AD pins.  The wrap body is 27 instructions;
; five one-time startup instructions make the program exactly 32 instructions.
.program issue112_c10_compact_frontend
    pull block
    mov y, osr
    wait 0 gpio 16
    wait 1 gpio 21
    wait 0 gpio 21
.wrap_target
    wait 1 gpio 9
    mov osr, pins
    in y, 15

    out x, 1                  ; GPIO0  = AD5
    in x, 1
    out null, 1              ; GPIO1

    out x, 3                 ; GPIO2..4 = AD14,AD13,AD15
    in x, 3
    out null, 1              ; GPIO5

    out x, 1                 ; GPIO6 = AD3
    in x, 1
    out null, 3              ; GPIO7..9

    out x, 6                 ; GPIO10..15 = AD6,AD8,AD7,AD2,AD12,AD4
    in x, 6
    out null, 1              ; GPIO16

    out x, 1                 ; GPIO17 = AD11
    in x, 1
    out null, 1              ; GPIO18

    out x, 1                 ; GPIO19 = AD1
    in x, 1
    out null, 2              ; GPIO20..21

    out x, 1                 ; GPIO22 = AD9
    in x, 1
    out null, 4              ; GPIO23..26 (A18,A19,UBE,AD0/A0)

    out x, 1                 ; GPIO27 = AD10
    in x, 1

    in null, 2               ; 32 bits total -> autopush
.wrap
