.pio_version rp2350

.program issue112_c9d_addr_frontend
; Continuous C5C-style read address frontend.
    pull block
    mov y, osr

    wait 0 gpio 16
    wait 1 gpio 21
    wait 0 gpio 21
.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
public address_settle:
    nop [7]

    mov isr, null
    in y, 16
    in pins, 14
    in null, 2
    push block
    jmp next_cycle
.wrap


.program issue112_c9d_responder
; Read response + write-data capture.
; BUFRW is jmp pin: LOW=read, HIGH=write.
.wrap_target
response_loop:
    pull block
    wait 0 gpio 9
    jmp pin write_cycle

read_cycle:
    out pins, 28
    mov pindirs, ~null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
public read_f2:
    wait 0 gpio 21
    mov pindirs, null
    jmp response_loop

write_cycle:
    mov pindirs, null
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21             ; R2
    mov isr, pins
    push block                 ; write data only
    jmp response_loop
.wrap


.program issue112_c9d_pointer_router
; TX receives the current backing pointer only AFTER the SRAM read DMA has
; completed for that bus cycle. BUFRW is jmp pin.
;
; Reads discard the pointer. Writes publish it to RX, providing a write-only
; pointer FIFO independent from the responder's write-data FIFO.
.wrap_target
router_loop:
    pull block
    mov y, osr
    wait 0 gpio 9
    jmp pin publish_write
    jmp router_loop

publish_write:
    mov isr, y
    push block
    jmp router_loop
.wrap


.program issue112_c9d_observer
; Diagnostic write-only observer.
; jmp pin = BUFRW: LOW=read, HIGH=write.
; RX publishes two words per physical write:
;   [0] T1 GPIO snapshot (address/control)
;   [1] R2 GPIO snapshot (write data)
.wrap_target
observer_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov x, pins
    jmp pin capture_write
    jmp observer_next

capture_write:
    mov isr, x
    push block

    wait 0 gpio 9              ; AF
    wait 1 gpio 21             ; R1
    wait 0 gpio 21             ; F1
    wait 1 gpio 21             ; R2
    mov isr, pins
    push block
    jmp observer_next
.wrap


.program issue112_c9j_window_observer
; T1 + AF/R1/F1/F1_LATE/R2/R2_LATE/F2 GPIO samples.
.wrap_target
observer_next:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block

    wait 0 gpio 9              ; AF
    mov isr, pins
    push block

    wait 1 gpio 21             ; R1
    mov isr, pins
    push block

    wait 0 gpio 21             ; F1
    mov isr, pins
    push block

    nop [11]
    mov isr, pins               ; F1_LATE
    push block

    wait 1 gpio 21             ; R2
    mov isr, pins
    push block

    nop [5]
    mov isr, pins               ; R2_LATE
    push block

    wait 0 gpio 21              ; F2
    mov isr, pins
    push block

    jmp observer_next
.wrap

; Each byte lane uses a separate PIO block. Its phase SM raises local IRQ 0
; at the rising edge in T3. Reads hold through the following falling edge.
.program issue112_c9o_phase
.wrap_target
    wait 1 gpio 9
    irq clear 0
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    irq 0
.wrap

.program issue112_c9o_responder
; TX = lane backing value, then its address. Active writes publish an
; address/data pair on RX. Reads drive only this PIO block's eight AD pins.
.wrap_target
next_cycle:
    wait 1 gpio 9
    nop [7]
    mov osr, pins
public select_bit:
    out null, 26                ; low: A0, patched to UBE# for high
    out x, 1                    ; 0 means selected
    pull block
    wait 0 gpio 9
    jmp pin write_cycle
    out pins, 28
    jmp x-- skip_drive
    wait 0 gpio 21
    mov pindirs, ~null
skip_drive:
    pull block                  ; discard backing address
    wait 1 irq 0
    wait 0 gpio 21 [4]          ; start T4, then hold
    mov pindirs, null
    jmp next_cycle
write_cycle:
    pull block                  ; backing address
    jmp x-- next_cycle
    mov isr, osr
    push block
    wait 1 irq 0
    mov isr, pins
    push block
.wrap

.program issue112_c9o_observer
; Compact observer shares instruction memory with address lookup and CLK.
.wrap_target
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    mov isr, pins               ; T3 rising
    push block
    wait 0 gpio 21
    mov isr, pins               ; T4 entry
    push block
.wrap

.program issue112_c9q_responder
; TX = lane backing value, then its address. Active writes publish an
; address/data pair on RX. Reads drive only this PIO block's eight AD pins.
.wrap_target
next_cycle:
    wait 1 gpio 9 [8]
    mov osr, pins
public select_bit:
    out null, 26                ; low: A0, patched to UBE# for high
    out x, 1                    ; 0 means selected
    pull block
    wait 0 gpio 9
    jmp pin write_cycle
    out pins, 28
    jmp x-- skip_drive
    wait 0 gpio 21
    mov pindirs, ~null
skip_drive:
    pull block                  ; discard backing address
    wait 1 irq 0
    wait 0 gpio 21 [4]          ; start T4, then hold
    mov pindirs, null
    jmp next_cycle
write_cycle:
    pull block                  ; backing address
    jmp x-- next_cycle
    in osr, 32 [1]              ; autopush pointer, retain two instruction cycles
    wait 1 irq 0
    in pins, 32 [1]             ; autopush data sampled on the original cycle
.wrap


.program issue112_c9q_address_observer
; Independent of the clock-phase tracker and of the responder's DMA FIFO.
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9 [8]
    in pins, 32
.wrap

.program issue112_c9q_window_observer
; Compact observer shares instruction memory with address lookup and CLK.
.wrap_target
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    wait 0 gpio 21
    mov isr, pins               ; T3 entry
    push block
    wait 1 gpio 21
    mov isr, pins               ; T3 rising
    push block
    wait 0 gpio 21
    mov isr, pins               ; T4 entry
    push block
.wrap
