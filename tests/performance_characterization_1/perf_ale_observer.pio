.program perf_ale_observer
.wrap_target
    ; Passive observer only. It never drives any bus pin.
    ; GPIO9 is the V30 ALE signal on the RP2350-PiZero routing.
    ;
    ; Keep replacing ISR with a whole-bank GPIO snapshot while ALE is high.
    ; When ALE falls, push the last snapshot taken before the falling edge.
    ; JMP PIN must be configured to GPIO9 and the input base to GPIO0.
    wait 0 gpio 9
    wait 1 gpio 9
capture_high:
    mov isr, pins
    jmp pin capture_high
    push block
.wrap
