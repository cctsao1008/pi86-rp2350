; PC1-B hardware-only read-data timing sweep at 0.300 MHz.
;
; Purpose:
;   Characterize which AD drive/release window is actually consumed by the V30.
;   M33 is absent from the per-cycle response path. PIO emits RX events, DMA
;   writes SIO OE/OUT registers, and a separate PIO0 observer judges control
;   flow from ALE addresses.
;
; Definitions (relative to ALE falling edge):
;   D1 = next fresh CLK rising edge
;   D2 = next fresh CLK falling edge
;   D3 = following CLK rising edge
;
; Hn means release on the nth subsequent fresh CLK falling edge after start.
; Stage timing is fixed for every case: next CLK rise after release. The release
; SM sets internal PIO IRQ4; the generic stage SM waits for that flag, clears it,
; waits for the next CLK rise, then emits the next-word DMA event.
;
; Physical pins:
;   ALE = GPIO9
;   CLK = GPIO21

; Start at D1. One constant OE mask is preloaded in OSR before the sweep run.
.program pc1b_sweep_d1_start
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    wait 1 gpio 21
    mov isr, osr
    push block
.wrap

; Start at D2.
.program pc1b_sweep_d2_start
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    wait 1 gpio 21
    wait 0 gpio 21
    mov isr, osr
    push block
.wrap

; Start at D3 (following rise after D2).
.program pc1b_sweep_d3_start
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    mov isr, osr
    push block
.wrap

; D1 start, release at second subsequent falling edge.
.program pc1b_sweep_d1_h2_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D1 start edge.
    wait 1 gpio 21
    ; H1.
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; D1 start, release at third subsequent falling edge.
.program pc1b_sweep_d1_h3_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D1.
    wait 1 gpio 21
    ; H1.
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H3.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; D2 start, release at second subsequent falling edge.
.program pc1b_sweep_d2_h2_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H1.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; D2 start, release at third subsequent falling edge.
.program pc1b_sweep_d2_h3_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H1.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H3.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; D2 start, release at fourth subsequent falling edge.
; This is an intentional boundary case. The test immediately returns to RESET
; after four observed ALE windows; any address corruption is reported as FAIL.
.program pc1b_sweep_d2_h4_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H1.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H3.
    wait 1 gpio 21
    wait 0 gpio 21
    ; H4.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; D3 start, release at second subsequent falling edge.
.program pc1b_sweep_d3_h2_release
    pull block
.wrap_target
    wait 1 gpio 9
    wait 0 gpio 9
    ; D2 then D3 start.
    wait 1 gpio 21
    wait 0 gpio 21
    wait 1 gpio 21
    ; H1.
    wait 0 gpio 21
    ; H2.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 4
    mov isr, osr
    push block
.wrap

; Generic ordered next-word staging. Release SM sets IRQ4 at its selected edge.
; Stage then waits until the next CLK rising edge before changing GPIO_OUT.
.program pc1b_sweep_stage
.wrap_target
    wait 1 irq 4
    irq clear 4
    wait 1 gpio 21
    pull block
    mov isr, osr
    push block
.wrap
