; PC1-B minimal deterministic timing front-end.
;
; Physical pin ABI on Waveshare RP2350-PiZero + Pi86 HAT:
;   ALE = RP2350 GPIO9
;   CLK = RP2350 GPIO21
;
; This program never drives any V30 signal. It only watches ALE/CLK and raises
; PIO interrupt flags at the experimentally selected D2/H2 boundaries:
;
;   IRQ0: D2 start event
;         after ALE falls, at the next fresh CLK falling edge
;
;   IRQ1: H2 release event
;         after two additional fresh CLK falling edges
;
; M33/SIO remains responsible for the non-contiguous AD15:0 data pins.
;
.program pc1b_d2h2_events
.wrap_target
    ; Require an idle-low ALE before arming for the next bus cycle.
    wait 0 gpio 9
    ; Observe the next ALE-high T1 window and its falling edge.
    wait 1 gpio 9
    wait 0 gpio 9

    ; D2: next fresh CLK falling edge after ALE falls.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 0

    ; H1: first subsequent fresh falling edge.
    wait 1 gpio 21
    wait 0 gpio 21

    ; H2: second subsequent fresh falling edge; request AD release.
    wait 1 gpio 21
    wait 0 gpio 21
    irq set 1
.wrap
