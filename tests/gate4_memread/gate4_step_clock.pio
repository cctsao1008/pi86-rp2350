.program gate4_step_clk
.wrap_target
    ; Host-controlled clock stepping for early V30 bus bring-up.
    ;
    ; The state machine runs at 2 MHz. Each SET instruction plus [9]
    ; delay slots therefore holds the clock level for 5 us, giving a
    ; nominal 100 kHz V30 clock pulse. The PULL instruction intentionally
    ; stalls with CLK low between host-issued steps so firmware can latch
    ; T1, inspect control state, and prepare read data without needing READY.
    pull block
    set pins, 1 [9]
    set pins, 0 [9]

    ; Push a completion token after the low phase. The host waits for this
    ; token before sampling GPIO or issuing the next clock step.
    mov isr, null
    push block
.wrap
