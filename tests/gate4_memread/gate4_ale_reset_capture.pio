.program gate4_ale_reset_capture

; Finite passive GPIO sampler for Gate 4 reset/ALE validation.
;
; Design goals:
; - No WAIT on RESET or ALE: the capture must not assume the signal behavior
;   that it is intended to verify.
; - No GPIO direction/output changes: this state machine is observation-only.
; - Fixed sample cadence independent of CPU/FIFO draining. DMA drains RX FIFO.
; - Exact finite sample count: after the requested samples are pushed, the
;   program stalls on an empty TX FIFO instead of continuing to push and
;   creating a post-capture RXSTALL false alarm.
;
; Host configuration:
; - IN base = GPIO0
; - shift-right, no autopush
; - state-machine clock = 8 MHz
; - host preloads TX FIFO with (sample_count - 1) before enabling the SM
;
; The steady-state sample loop is exactly four PIO instructions:
;   mov / in / push / jmp
; At 8 MHz this gives a nominal 0.5 us sample interval.
; `in pins, 28` places GPIO0..GPIO27 in ISR[31:4] with shift-right;
; firmware shifts each DMA word right by four bits.

.wrap_target
    pull block              ; OSR <- sample_count - 1
    mov x, osr
sample:
    mov isr, null
    in pins, 28
    push block
    jmp x-- sample

    ; Exact sample count reached. Stall here forever unless the host writes
    ; another TX word. No more RX pushes occur, so RXSTALL after DMA completion
    ; cannot be caused by post-capture sampling.
    pull block
.wrap
