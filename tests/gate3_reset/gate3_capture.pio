.program gate3_clk
.wrap_target
    set pins, 1
    set pins, 0
.wrap

.program gate3_capture
.wrap_target
    ; RESET is active HIGH. Do not accept any bus activity until the host
    ; releases RESET LOW.
    wait 0 gpio 16

    ; Capture several points across the first post-reset ALE pulse instead
    ; of sampling immediately at the assertion edge. The capture SM is run
    ; at 2 MHz by the host, so each PIO instruction is approximately 0.5 us.
    ; This lets us see the address settle during T1.
    wait 1 gpio 12

    ; ~0.5 us after ALE-high is observed.
    mov isr, pins
    push block

    ; ~1.5 us after ALE-high is observed.
    mov isr, pins
    push block

    ; ~2.5 us after ALE-high is observed.
    mov isr, pins
    push block

    ; Capture once more just after the falling edge. ASTB/ALE is intended
    ; to latch address information, so this sample is useful as a boundary
    ; diagnostic even though the primary acceptance samples are the three
    ; ALE-high samples above.
    wait 0 gpio 12
    mov isr, pins
    push block

    ; Do not run into the next bus cycle. Wait for the host to reassert
    ; RESET before allowing the state machine to wrap and re-arm.
    wait 1 gpio 16
.wrap
