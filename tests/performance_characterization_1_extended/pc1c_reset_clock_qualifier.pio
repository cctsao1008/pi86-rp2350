; Passive RESET clock qualification for PC1-C0C1-B1.
;
; This SM starts in sync with the PIO2 clock generator while RESET remains
; asserted. It observes twenty complete physical CLK high/low periods through
; the default GPIO input synchronizer, then pushes one raw GPIO evidence word.
; Response and runtime observer SMs remain disabled during this qualification.

.pio_version rp2350
.program pc1c_reset_clock_qualifier

    set x, 19                  ; current period plus 19 loop-back periods
count_period:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- count_period
    mov isr, pins
    push block
done:
    jmp done
