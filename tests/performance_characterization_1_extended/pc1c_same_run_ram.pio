; PC1-C0C1-B2-B exact learned-path matcher plus one-slot dynamic RAM.
;
; PIO1 instruction memory contract: matcher 9 + responder 23 = 32 words.
; Firmware preloads the first exact early-T1 key into matcher Y.  DMA supplies
; each following key, including one terminal impossible key.  An unrelated
; bus cycle does not advance either FIFO.
;
; Responder descriptor (30 significant bits, shifted right):
;   [27:0] scattered AD GPIO bitmap for a static ROM response
;   [28]   operation: 1 = drive/replay, 0 = capture
;   [29]   source:    0 = static ROM,   1 = dynamic RAM slot
;
; Static ROM: bit29=0, bit28=1, bitmap is driven.
; RAM write : bit29=1, bit28=0, R2 data is captured into ISR.
; RAM read  : bit29=1, bit28=1, ISR is replayed onto AD.
;
; Only supported ROM reads and the one RAM write/read are placed in the exact
; sequence. Unsupported cycles remain high-Z and are ignored by the matcher.

.pio_version rp2350
.program pc1c_same_run_ram_matcher
.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov x, pins
    jmp x!=y next_cycle
    irq 0
    pull block
    mov y, osr
    jmp next_cycle
.wrap

.program pc1c_same_run_ram_responder
.wrap_target
respond:
    wait 1 irq 0
    irq clear 0
    pull block
    out pins, 28
    out x, 1
    out y, 1
    jmp !y static_drive
    jmp !x capture_write

    ; Dynamic read: replace the unused descriptor bitmap with the value that
    ; the preceding write captured directly from the V30 at R2.
    mov osr, isr
    out pins, 28

static_drive:
    wait 0 gpio 9
    mov pindirs, ~null
    set x, 1
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop
    mov pindirs, null
    jmp respond

capture_write:
    wait 0 gpio 9
    wait 0 gpio 21
    wait 1 gpio 21
    mov isr, pins
    jmp respond
.wrap
