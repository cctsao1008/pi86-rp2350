; PC1-C0C0 passive address/control and write-data observer.
;
; Each physical ASTB cycle emits two whole-bank GPIO snapshots:
;   1. early T1, after the same eight-cycle synchronizer settling interval used
;      by the PIO1 matcher;
;   2. R2, where V30 write data and PIO1 read response data are stable.
;
; RX framing is therefore:
;   word 2n     = address/control snapshot for cycle n;
;   word 2n + 1 = R2 data snapshot for cycle n.
;
; RESET may be asserted after a final early-T1 word but before that cycle
; reaches R2. Firmware accepts exactly one terminal ASTB-high T1 tail and never
; classifies it as a complete cycle. Any other odd framing is invalid.
;
; Configure IN base to GPIO0, join the RX FIFO, and drain it with a paced DMA
; channel. Both pushes are blocking so loss of evidence is visible as a timing
; failure rather than silently dropping a sample. This program never writes
; pins or PINDIRS and cannot affect bus ownership.

.pio_version rp2350
.program pc1c_sram_rom_execution_observer

.wrap_target
    wait 0 gpio 9              ; synchronize to a complete idle/address boundary
    wait 1 gpio 9              ; ASTB rise: V30 presents multiplexed address
    nop [7]                    ; match PIO1's validated early-T1 settling point
    mov isr, pins
    push block                 ; pair word 0: address/control

    wait 0 gpio 9              ; ASTB fall ends the address phase
    wait 1 gpio 21             ; R1
    wait 0 gpio 21             ; F1
    wait 1 gpio 21             ; R2: read response/write payload is stable
    mov isr, pins
    push block                 ; pair word 1: data phase
.wrap
