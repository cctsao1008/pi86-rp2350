; PC1-C qualified dynamic AD response.
;
; One TX FIFO command is required for every observed ASTB cycle:
;   bits  0..27: encoded GPIO0..27 output bitmap
;   bit      28: drive enable (1 = drive, 0 = remain high-Z)
;
; The CPU supplies the command after the PIO1 T1 capture has classified the
; current cycle. Consuming a command for misses keeps the responder aligned
; with the bus even when it must not drive.
;
; Y is preloaded by the host with the PIO1 direction bits that must remain
; outputs when AD is released. C0B places CLK on the same PIO, so Y preserves
; GPIO21 while clearing the scattered AD directions.
;
; The final JMP PIN gate rechecks ASTB after the command is pulled. A late CPU
; command is consumed to preserve cycle alignment but can never assert AD OE.

.pio_version rp2350
.program pc1c_qualified_ad
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    wait 0 gpio 9

    pull block
    out pins, 28
    out x, 1
    jmp !x no_drive
    jmp pin drive_allowed
    jmp no_drive
drive_allowed:
    mov pindirs, ~null

    ; H2: release after the second falling CLK edge following ASTB-fall.
    set x, 1
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop
    mov pindirs, y

no_drive:
    mov pindirs, y
.wrap
