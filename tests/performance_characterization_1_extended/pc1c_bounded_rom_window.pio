; PC1-C0C1-B1 bounded multi-cycle current-address ROM selector.
;
; The DMA stream contains one complete table block per physical V30 cycle.
; Every block is identical; repetition supplies a finite execution budget and
; never predicts fetch order. Each ordinary entry is three 32-bit words:
;
;   word 0 = 0                         entry tag
;   word 1 = exact early-T1 raw key    address + MEMR/control qualification
;   word 2 = encoded GPIO0-27 response
;
; A block ends with one word whose bit 0 is 1. Reaching that sentinel without
; a key match is an explicit miss: PINDIRS remain clear, the SM waits for the
; current ASTB phase to finish, and the next physical cycle starts from the
; first entry of the next identical block.
;
; After a hit, the response is gated while ASTB is still high, driven at ASTB
; fall, and released at the accepted H2 boundary. The remaining entries are
; drained through the sentinel before the next V30 cycle. At the 0.300 MHz
; baseline this drain has a large measured-clock margin; higher frequencies
; require separate physical characterization.
;
; Configure IN base GPIO0, OUT base GPIO0/count 28, right-shift OUT, and JMP
; pin ASTB. PIO2 owns CLK so MOV PINDIRS,NULL releases the complete PIO1 group.

.pio_version rp2350
.program pc1c_bounded_rom_window

    wait 0 gpio 9              ; clean initial ASTB boundary

.wrap_target
next_cycle:
    wait 1 gpio 9              ; physical ASTB rise
    nop [7]                    ; accepted synchronized-input settling interval
    mov x, pins                ; exact current early-T1 raw key

search:
    pull block                 ; entry/sentinel tag, bit 0 significant
    out y, 1
    jmp !y candidate
    wait 0 gpio 9              ; explicit miss: never authorize PINDIRS
    jmp next_cycle

candidate:
    pull block                 ; candidate exact raw key
    mov y, osr
    jmp x!=y mismatch

    pull block                 ; selected encoded GPIO response
    out pins, 28               ; preload output latches while high-Z
    jmp pin armed              ; only an ASTB-high hit may drive
    jmp release                ; late hit remains high-Z, then drains the block

armed:
    wait 0 gpio 9              ; address-to-data turnaround
    mov pindirs, ~null         ; enable only PIO1-muxed scattered AD pins
    set x, 1                   ; release after second post-ASTB CLK fall (H2)
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop

release:
    mov pindirs, null          ; return AD to high-Z; PIO2 retains CLK

drain:
    pull block                 ; discard unused entries through sentinel
    out y, 1
    jmp !y drain_entry
    jmp next_cycle

drain_entry:
    pull block                 ; unused candidate key
    pull block                 ; unused response
    jmp drain

mismatch:
    pull block                 ; discard response paired with mismatching key
    jmp search
.wrap
