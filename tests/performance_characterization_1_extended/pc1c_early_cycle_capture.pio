; PC1-C0B early V30 cycle capture.
;
; Capture one whole-bank GPIO snapshot eight PIO cycles after ASTB rises. An
; immediate sample was physically too early for the V30 high-address pins,
; while waiting for the first CLK rise left no response time before ASTB fell.
; At the default 150 MHz PIO clock this 53 ns settling delay remains in early
; T1 and leaves the rest of the phase for the M33 lookup.
;
; Configure IN base to GPIO0, JMP PIN to GPIO9 (ASTB), and join the RX FIFO.
; This program never writes pins or PINDIRS.

.program pc1c_early_cycle_capture
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov isr, pins
    push block
    wait 0 gpio 9
.wrap
