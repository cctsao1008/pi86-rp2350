; PC1-C0B early V30 cycle capture.
;
; Capture one whole-bank GPIO snapshot immediately after ASTB rises. The V30
; address and minimum-mode cycle controls are already coherent during T1, so
; the M33 can qualify and prepare the current-cycle response before ASTB falls.
;
; Configure IN base to GPIO0, JMP PIN to GPIO9 (ASTB), and join the RX FIFO.
; This program never writes pins or PINDIRS.

.program pc1c_early_cycle_capture
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    mov isr, pins
    push block
    wait 0 gpio 9
.wrap
