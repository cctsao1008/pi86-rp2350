; PC1-C0B early V30 cycle capture.
;
; Capture one whole-bank GPIO snapshot on the first CLK rise while ASTB is
; high. The immediate ASTB-rise sample is too early for the V30 high-address
; pins; the CLK-rise phase was physically observed coherent by PC1-C0A. This
; still leaves the latter half of T1 for the M33 to prepare the response before
; ASTB falls.
;
; Configure IN base to GPIO0, JMP PIN to GPIO9 (ASTB), and join the RX FIFO.
; This program never writes pins or PINDIRS.

.program pc1c_early_cycle_capture
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    wait 1 gpio 21
    mov isr, pins
    push block
    wait 0 gpio 9
.wrap
