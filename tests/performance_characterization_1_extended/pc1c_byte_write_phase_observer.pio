; PC1-C0C1-B2-C0 passive byte-write phase characterization observer.
;
; Each physical ASTB cycle emits six whole-bank GPIO snapshots:
;   0 early T1 address/control, after the validated eight-cycle settling time;
;   1 R1, 2 F1, 3 R2, 4 F2, 5 R3.
;
; The existing C0C1 observer assumes R2 is the write-data sampling point. That
; assumption is validated for 16-bit writes but not for byte writes. This
; instrument deliberately captures every surrounding clock edge so the LOW8
; and HIGH8 data-valid phase can be selected from physical evidence.
;
; Configure IN base to GPIO0, join RX, and drain with paced DMA. The program
; contains no pin-output or PINDIRS instruction and cannot own the AD bus.

.pio_version rp2350
.program pc1c_byte_write_phase_observer

.wrap_target
    wait 0 gpio 9              ; complete idle/address boundary
    wait 1 gpio 9              ; ASTB rise: multiplexed address
    nop [7]                    ; default synchronizer settling interval
    mov isr, pins
    push block                 ; word 0: early T1 address/control

    wait 0 gpio 9              ; ASTB fall ends address phase
    wait 1 gpio 21
    mov isr, pins
    push block                 ; word 1: R1

    wait 0 gpio 21
    mov isr, pins
    push block                 ; word 2: F1

    wait 1 gpio 21
    mov isr, pins
    push block                 ; word 3: R2

    wait 0 gpio 21
    mov isr, pins
    push block                 ; word 4: F2

    wait 1 gpio 21
    mov isr, pins
    push block                 ; word 5: R3
.wrap
