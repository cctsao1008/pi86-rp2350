; PC1-B ALE-fall (AF) hardware-only response timing.
;
; Start emits immediately after ALE falls. Release and stage use Y as a
; per-case hold selector configured by the host before each run:
;   Y=1 -> H2 (second falling CLK edge after ALE fall)
;   Y=2 -> H3
;   Y=3 -> H4
;
; Stage emits on the next rising CLK edge after the selected release edge.
; Each event word is supplied by the SM TX FIFO and moved to RX for DMA.
;
; Physical pins:
;   ALE = GPIO9
;   CLK = GPIO21

.program pc1b_af_start
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    wait 0 gpio 9
    ; AF: emit as soon as ALE falls; do not wait for a CLK transition.
    pull block
    mov isr, osr
    push block
.wrap

.program pc1b_af_release
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    wait 0 gpio 9
    mov x, y
release_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- release_fall_loop
    pull block
    mov isr, osr
    push block
.wrap

.program pc1b_af_stage
.wrap_target
    wait 0 gpio 9
    wait 1 gpio 9
    wait 0 gpio 9
    mov x, y
stage_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- stage_fall_loop
    ; Keep the ordered policy: update GPIO_OUT only after the next rise.
    wait 1 gpio 21
    pull block
    mov isr, osr
    push block
.wrap
