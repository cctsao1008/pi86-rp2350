; PC1-C PIO-local descriptor matcher and AD-bus responder.
;
; State-machine split:
;   matcher   observes the physical early-T1 GPIO bank and qualifies one key;
;   responder consumes the paired descriptor and owns AD/PINDIRS timing.
;
; Matcher TX word (32 bits):
;   [31:0] exact raw GPIO0-31 snapshot expected at early T1.
;
; Responder TX word (29 significant bits, shifted right):
;   [27:0] complete GPIO0-27 output bitmap for the scattered AD response;
;   [28]   response-valid/OE bit: 1 drives AD, 0 is a high-Z sentinel.
;
; The two TX streams must contain the same number of entries in the same order.
; A pair advances only after the current physical snapshot exactly matches the
; current key. Unrelated prefetches, writes, or unsupported cycles remain
; high-Z and do not consume either entry. This is a bounded known-path engine,
; not the arbitrary-address PC1-C0C1 service.
;
; Internal PIO1 IRQ flag 0 is a one-pair handshake. The matcher sets it only on
; an exact match; the responder clears it before pulling the paired descriptor.
;
; Configure the matcher IN base to GPIO0. Configure the responder OUT base to
; GPIO0/count 28 with right-shift enabled. Only CLK and the scattered AD pins
; are muxed to PIO1, so bitmap bits for other GPIOs cannot take pin ownership.
;
; Timing contract:
;   - GPIO input synchronizers remain enabled.
;   - The early-T1 sample is taken 8 PIO cycles after ASTB rises.
;   - A valid descriptor begins driving at ASTB fall.
;   - AD is released at H2, after the second post-ASTB falling CLK edge.
;
; See docs/pc1c_rom_execution_plan.md and ADR 0003 before changing the sample,
; drive, or release points.

.pio_version rp2350
.program pc1c_pio_rom_matcher

    ; Y is the current expected key. It is intentionally retained across
    ; unrelated cycles; only an exact physical match advances the FIFO.
    pull block                 ; first expected raw GPIO key
    mov y, osr

.wrap_target
next_cycle:
    wait 0 gpio 9              ; finish any cycle already active while arming
    wait 1 gpio 9              ; ASTB rise begins the next address phase
    nop [7]                    ; 8 cycles for synchronized A19:A0/control settle
    mov isr, pins
    mov x, isr
    push noblock               ; diagnostic copy; never stall the real-time path
    jmp x!=y no_match

    irq 0                      ; authorize exactly one paired response
    pull block                 ; next expected raw GPIO key
    mov y, osr
    wait 0 gpio 9              ; do not search again inside the same bus cycle
    jmp next_cycle

no_match:
    ; Keep Y and both descriptor streams unchanged. This is the property that
    ; lets unsupported cycles remain high-Z without desynchronizing the test.
    wait 0 gpio 9
    jmp next_cycle
.wrap

.program pc1c_pio_rom_responder
.wrap_target
    wait 1 irq 0               ; matcher proved the current physical key
    irq clear 0                ; consume the one-pair authorization
    pull block                 ; paired 28-bit bitmap + bit-28 validity
    wait 0 gpio 9              ; ASTB fall: address phase has ended
    out pins, 28               ; preload scattered AD output values
    out x, 1                   ; extract response-valid/OE into X
    jmp !x release             ; sentinel: keep AD high-Z for this cycle
    mov pindirs, ~null         ; valid read: enable PIO1-mapped AD outputs

    ; H2: release after the second falling CLK edge following ASTB-fall.
    set x, 1
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop

release:
    ; Y is initialized by firmware to the CLK-only direction mask. Restoring it
    ; releases every AD pin while preserving continuous PIO1 clock ownership.
    mov pindirs, y
.wrap
