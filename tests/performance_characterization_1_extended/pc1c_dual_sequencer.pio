; AI-B1-A dual exact-key sequencers for PIO1.
;
; Four state machines execute these two shared programs as two independent
; matcher/responder pairs:
;
;   SM0 ROM matcher      -- relative IRQ0 --> SM1 ROM responder
;   SM2 mailbox matcher  -- relative IRQ2 --> SM3 mailbox responder
;
; A matcher retains its current exact early-T1 key across unrelated physical
; cycles. It advances its TX FIFO and authorizes its paired responder only on
; an exact match. The paired response descriptor therefore advances only for
; its own qualified stream: ROM cycles cannot consume mailbox payload words,
; and mailbox cycles cannot consume ROM words.
;
; Matcher TX word:
;   [31:0] exact raw early-T1 GPIO snapshot
;
; Responder TX word, shifted right:
;   [27:0] encoded scattered-AD GPIO output bitmap
;   [28]   drive-valid bit; zero keeps AD high-Z for capture-only events
;
; SM1 and SM3 both map OUT/PINDIRS over GPIO0..27. Their exact key sets must
; be disjoint. RP2350 gives a simultaneous write from the higher-numbered SM
; priority, but AI-B1 treats any dual authorization as an invalid epoch rather
; than relying on that priority for normal operation.
;
; PIO2 owns CLK. MOV PINDIRS,NULL therefore releases all PIO1-mapped AD pins.
; PIO0 independently observes address/control and R2 data. No M33 lookup is
; present in the current-cycle response path.
;
; Combined instruction use is 24 words (matcher 11 + responder 13), within
; the single 32-word instruction memory shared by all four PIO1 state machines.

.pio_version rp2350
.program pc1c_dual_matcher

    ; Y is the current expected exact key. It advances only after a match.
    pull block
    mov y, osr

.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov x, pins
    jmp x!=y no_match

    ; Relative IRQ0 maps SM0 -> IRQ0 and SM2 -> IRQ2.
    irq 0 rel
    pull block
    mov y, osr

no_match:
    wait 0 gpio 9
.wrap

.program pc1c_dual_responder
.wrap_target
respond:
    ; Relative IRQ3 means the preceding SM: SM1 -> IRQ0, SM3 -> IRQ2.
    wait 1 irq 3 rel
    irq clear 3 rel
    pull block
    wait 0 gpio 9
    out pins, 28
    out x, 1
    jmp !x release
    mov pindirs, ~null

    ; Retain the accepted H2 release boundary: the second post-ASTB CLK fall.
    set x, 1
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop

release:
    mov pindirs, null
.wrap
