; PC1-C0C1-B2-C learned-path matcher and indexed PIO-local RAM.
;
; PIO1 instruction memory: matcher 8 + responder 24 = 32 words.
; The responder uses RP2350 PIO v1 PUTGET mode, which preserves its normal
; four-word TX descriptor FIFO while exposing four RX storage entries to
; indexed state-machine MOV instructions.
;
; Descriptor, shifted right:
;   [27:0] encoded static AD bitmap (ROM only)
;   [28]   1 = drive/read, 0 = capture/write
;   [30:29] storage slot: 0 = static ROM, 1..3 = dynamic RAM
;
; Slot 1 and slot 2 hold independent word values. Slot 3 is reused in ordered
; LOW- then HIGH-byte write/read tests. Unsupported cycles consume no entry.

.pio_version rp2350
.program pc1c_multi_slot_ram_matcher
.wrap_target
next_cycle:
    wait 0 gpio 9
    wait 1 gpio 9
    nop [7]
    mov x, pins
    jmp x!=y next_cycle
    irq 0
    pull block
    mov y, osr
.wrap

.program pc1c_multi_slot_ram_responder
.fifo putget
.wrap_target
respond:
    wait 1 irq 0
    irq clear 0
    pull block
    out pins, 28
    out x, 1
    out y, 2
    jmp !y static_drive
    jmp !x capture_write

    ; A dynamic read fetches the raw scattered-GPIO word retained in the
    ; indexed storage entry selected by descriptor Y.
    mov osr, rxfifo[y]
    out pins, 28

static_drive:
    wait 0 gpio 9
    mov pindirs, ~null
    set x, 1
hold_fall_loop:
    wait 1 gpio 21
    wait 0 gpio 21
    jmp x-- hold_fall_loop
    mov pindirs, null
    jmp respond

capture_write:
    wait 0 gpio 9
    wait 0 gpio 21
    wait 1 gpio 21
    mov isr, pins
    mov rxfifo[y], isr
    jmp respond
.wrap
