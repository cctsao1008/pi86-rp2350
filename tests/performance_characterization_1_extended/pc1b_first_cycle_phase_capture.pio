; Passive first-reset-cycle GPIO phase capture for PC1-B.
;
; Captures six whole-bank GPIO snapshots without driving any pin:
;   0 AF    : ALE falling edge
;   1 R1    : first CLK rise after ALE fall
;   2 F1    : first CLK fall after ALE fall
;   3 R2    : second CLK rise
;   4 F2    : second CLK fall
;   5 R3    : third CLK rise
;
; Configure IN base to GPIO0 and join RX FIFO so all six snapshots fit.

.program pc1b_first_cycle_phase_capture
    wait 0 gpio 9
    wait 1 gpio 9
    wait 0 gpio 9
    mov isr, pins
    push block

    wait 1 gpio 21
    mov isr, pins
    push block

    wait 0 gpio 21
    mov isr, pins
    push block

    wait 1 gpio 21
    mov isr, pins
    push block

    wait 0 gpio 21
    mov isr, pins
    push block

    wait 1 gpio 21
    mov isr, pins
    push block

phase_capture_done:
    jmp phase_capture_done
